APP_NAME=HireKiwi RAG Knowledge Assistant
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./uploads
CHROMA_DIR=./chroma_store
SAMPLE_DOCUMENTS_DIR=./sample_documents
MAX_UPLOAD_MB=20
PDF_EXTRACTION_TIMEOUT_SECONDS=180
JWT_SECRET_KEY=change-this-local-secret
JWT_EXPIRE_MINUTES=120
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_COLLECTION=document_chunks
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_TOP_K=6
DEFAULT_LLM_MODEL=qwen2.5:1.5b
CHUNK_TARGET_TOKENS=240
CHUNK_OVERLAP_TOKENS=60
MAX_DOCUMENT_CHARS=5000000
MAX_GENERATION_PASSAGES=12
MAX_GENERATION_CONTEXT_CHARS=8000
DEBUG_LLM_OUTPUT=false

